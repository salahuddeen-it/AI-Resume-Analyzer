@{
    ViewData["Title"] = "Error";
    var code = Context.Response.StatusCode;
}
<div class="container py-5 text-center">
    <div class="empty-state mx-auto">
        <div class="empty-icon"><i class="bi @(code == 404 ? "bi-search" : "bi-exclamation-triangle")"></i></div>
        <h2 class="fw-bold">@(code == 404 ? "Page not found" : "Something went wrong")</h2>
        <p class="text-muted">@(code == 404 ? "The page or analysis you are looking for does not exist." : "An unexpected error occurred. Please try again.")</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-gradient mt-2"><i class="bi bi-house me-1"></i> Go to Home</a>
    </div>
</div>
