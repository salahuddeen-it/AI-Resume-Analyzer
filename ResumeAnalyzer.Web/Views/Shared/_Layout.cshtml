@inject Microsoft.Extensions.Options.IOptions<AiSettings> AiOptions
@{
    var ai = AiOptions.Value;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · ResumeIQ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg app-navbar sticky-top no-print">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-icon"><i class="bi bi-file-earmark-person"></i></span>
                Resume<span class="text-gradient">IQ</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <i class="bi bi-list fs-3"></i>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index"><i class="bi bi-cloud-arrow-up me-1"></i> Analyze</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Analysis" ? "active" : "")" asp-controller="Analysis" asp-action="History"><i class="bi bi-clock-history me-1"></i> History</a>
                    </li>
                    <li class="nav-item ms-lg-2">
                        <span class="ai-badge @(ai.IsConfigured ? "live" : "demo")" title="@(ai.IsConfigured ? "AI provider in use" : "No API key configured – using offline demo analysis")">
                            <i class="bi @(ai.IsConfigured ? "bi-cpu" : "bi-exclamation-circle")"></i> @ai.DisplayName
                        </span>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="toast-area no-print">
        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success shadow-sm d-flex align-items-center gap-2 auto-dismiss"><i class="bi bi-check-circle-fill"></i> @ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger shadow-sm d-flex align-items-center gap-2 auto-dismiss"><i class="bi bi-x-circle-fill"></i> @err</div>
        }
    </div>

    <main>
        @RenderBody()
    </main>

    <footer class="app-footer no-print">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>© @DateTime.Now.Year ResumeIQ – AI Resume Analyzer</span>
            <span>Built with ASP.NET Core 8 · EF Core · SQL Server</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
