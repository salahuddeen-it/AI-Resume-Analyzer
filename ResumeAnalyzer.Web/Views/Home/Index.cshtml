@model UploadViewModel
@{
    ViewData["Title"] = "Analyze Resume";
}

<section class="hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <span class="hero-pill"><i class="bi bi-stars"></i> AI-powered resume review</span>
                <h1 class="hero-title">Know your resume's <span class="text-gradient">real score</span> in seconds</h1>
                <p class="hero-sub">
                    Upload a CV and get an instant analysis of skills, experience, education, missing skills
                    and a match score against any job description.
                </p>
                <ul class="feature-list">
                    <li><i class="bi bi-speedometer2"></i> Resume score out of 100</li>
                    <li><i class="bi bi-bullseye"></i> Job description matching</li>
                    <li><i class="bi bi-lightbulb"></i> Actionable improvements</li>
                    <li><i class="bi bi-database-check"></i> Saved analysis history</li>
                </ul>
            </div>

            <div class="col-lg-7">
                <div class="card glass-card upload-card">
                    <div class="card-body p-4 p-md-5">
                        <form asp-controller="Home" asp-action="Analyze" method="post" enctype="multipart/form-data" id="analyzeForm" novalidate>
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                            <label for="ResumeFile" class="dropzone" id="dropzone">
                                <input asp-for="ResumeFile" type="file" accept=".pdf,.docx" class="d-none" />
                                <span class="dropzone-icon"><i class="bi bi-cloud-arrow-up"></i></span>
                                <span class="dropzone-title" id="fileName">Drag &amp; drop your resume here</span>
                                <span class="dropzone-sub">or <span class="text-primary fw-semibold">browse files</span> · PDF or DOCX · max @UploadViewModel.MaxFileSizeMB MB</span>
                            </label>
                            <span asp-validation-for="ResumeFile" class="text-danger small d-block mt-2"></span>

                            <div class="mt-4">
                                <label asp-for="JobDescription" class="form-label fw-semibold">
                                    <i class="bi bi-briefcase me-1"></i> Job Description <span class="text-muted fw-normal">(optional)</span>
                                </label>
                                <textarea asp-for="JobDescription" class="form-control jd-input" rows="5"
                                          placeholder="Paste a job description here to see matching and missing skills..."></textarea>
                                <span asp-validation-for="JobDescription" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-gradient btn-lg w-100 mt-4" id="analyzeBtn">
                                <i class="bi bi-magic me-2"></i>Analyze Resume
                            </button>
                            <p class="text-center text-muted small mt-3 mb-0"><i class="bi bi-shield-lock me-1"></i> Your file is processed securely and stored only in your history.</p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.RecentAnalyses.Any())
{
    <section class="container pb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Recent analyses</h5>
            <a asp-controller="Analysis" asp-action="History" class="small fw-semibold text-decoration-none">View all <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="row g-3">
            @foreach (var item in Model.RecentAnalyses)
            {
                <div class="col-sm-6 col-lg-3">
                    <a asp-controller="Analysis" asp-action="Details" asp-route-id="@item.Id" class="card glass-card recent-card text-decoration-none h-100">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="mini-ring" style="--score:@item.OverallScore;--ring-color:@ScoreHelper.Color(item.OverallScore)"><span>@item.OverallScore</span></div>
                            <div class="overflow-hidden">
                                <div class="fw-semibold text-dark text-truncate">@item.CandidateName</div>
                                <div class="small text-muted text-truncate">@item.FileName</div>
                                <div class="small text-muted">@item.CreatedAt.ToLocalTime().ToString("dd MMM, hh:mm tt")</div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
}

<div class="loading-overlay" id="loadingOverlay">
    <div class="loading-box">
        <div class="loader"></div>
        <h5 class="fw-bold mt-4 mb-1">Analyzing resume…</h5>
        <p class="text-muted mb-0" id="loadingStep">Extracting text from your file</p>
    </div>
</div>
